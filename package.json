{
  "name": "tarantal-madness",
  "version": "1.9.4",
  "private": true,
  "type": "module",
  "description": "Tarantal Madness — a panning shooting gallery starring the helmeted guineafowl.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:poki": "VITE_PLATFORM=poki npm run build",
    "build:crazygames": "VITE_PLATFORM=crazygames npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sim.json",
    "content:validate": "tsx tools/validate-content.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run content:validate",
    "size": "tsx tools/size-check.ts",
    "golden:update": "tsx tools/golden-update.ts",
    "project:check": "tsx tools/project-log-check.ts",
    "hunt": "tsx tools/run-hunt.ts",
    "balance": "tsx tools/balance-sim.ts",
    "assets:pack": "tsx tools/pack-atlases.ts",
    "assets:standins": "tsx tools/make-standins.ts",
    "assets:audit": "tsx tools/asset-audit.ts",
    "art:interim": "tsx tools/art/interim.ts",
    "audio:interim": "tsx tools/audio/interim.ts",
    "audio:voice": "tsx tools/audio/voice.ts",
    "fonts:build": "tsx tools/make-fonts.ts",
    "portal:shots": "VITE_TEST_HOOKS=1 npm run build && tsx tools/portal-shots.ts",
    "release": "tsx tools/release.ts"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/baloo-2": "5.3.0",
    "@fontsource/bangers": "5.3.0",
    "@playwright/test": "1.56.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.4",
    "@types/upng-js": "2.1.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "subset-font": "2.9.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "upng-js": "2.1.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wasm-media-encoders": "0.7.0"
  }
}
