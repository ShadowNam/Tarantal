{
  "name": "tarantal-madness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tarantal Madness — a panning shooting gallery starring the helmeted guineafowl.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sim.json",
    "content:validate": "tsx tools/validate-content.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run content:validate",
    "size": "tsx tools/size-check.ts",
    "golden:update": "tsx tools/golden-update.ts",
    "hunt": "tsx tools/run-hunt.ts"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
